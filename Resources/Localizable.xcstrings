    },
    "%@ translates on this Mac" : {
      "comment" : "Tooltip of the engine chip for an on-device engine. %@ = engine name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在这台 Mac 上翻译"
          }
        }
      }
    },
    "%@ · Not installed" : {
      "comment" : "Ignored app that isn't installed. %@ = bundle ID",
