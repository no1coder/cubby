{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%lld)" : {
      "comment" : "Screenshot style bar color tooltip: color name and the number key that selects it",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$lld)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$lld）"
          }
        }
      }
    },
    "%@ (App Translocation)" : {
      "comment" : "Diagnostics: install location under App Translocation",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（系统隔离路径）"
          }
        }
      }
    },
    "%@ ([ ])" : {
      "comment" : "Screenshot style bar weight tooltip: weight name; the [ and ] keys change the weight",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（[ ] 调节）"
          }
        }
      }
    },
    "%@ (disk image)" : {
      "comment" : "Diagnostics: install location on a disk image",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（磁盘映像）"
          }
        }
      }
    },
    "%@ (on this Mac)" : {
      "comment" : "Engine name for an on-device engine, e.g. System Translation (on this Mac)",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（本机）"
          }
        }
      }
    },
    "%@ and %lld more (%lld files)" : {
      "comment" : "Title of an item with several files. %1$@ = first file name, %2$lld = number of other files, %3$lld = total number of files. Translations may omit %2$lld or %3$lld.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and %2$lld more"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 等 %3$lld 个文件"
          }
        }
      }
    },
    "%@ is a system shortcut" : {
      "comment" : "Shortcut recorder error",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是常用系统快捷键"
          }
        }
      }
    },
    "%@ is already in use. Switched back to %@." : {
      "comment" : "HUD when a new global shortcut is taken. %1$@ = new shortcut, %2$@ = previous shortcut",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is already in use. Switched back to %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已被占用，已恢复为 %2$@"
          }
        }
      }
    },
    "%@ is limiting requests" : {
      "comment" : "Translation failure title",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 限制了请求频率"
          }
        }
      }
    },
    "%@ is used by another app. Choose a different shortcut in Settings." : {
      "comment" : "HUD when the global shortcut is taken",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已被其他应用占用，请在设置中更换"
          }
        }
      }
    },
    "%@ of text" : {
      "comment" : "Size of a large text item, e.g. “1.2 MB of text”",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 文本"
          }
        }
      }
    },
    "%@ rejected the API key" : {
      "comment" : "Translation failure title",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了 API Key"
          }
        }
      }
    },
    "%@ returned an error (%lld)" : {
      "comment" : "Translation failure title",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ returned an error (%2$lld)"
