        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@：文字会发送到 %2$@ · 点按查看选项"
          }
        }
      }
    },
    "%@: translated on this Mac, offline · click for options" : {
      "comment" : "Tooltip of the engine chip on the translation card for an on-device engine",
